  m_text: "\uAC70\uB9AC\uAC00 \uBA40\uC5B4\uC9C8\uC218\uB85D \uD68D\uB4DD \uD560
    \uC218 \uC788\uB294 \uC7AC\uB8CC\uAC00 \uC0C8\uB86D\uAC8C \uCD94\uAC00\uB429\uB2C8\uB2E4.\n\n------------------\uC7AC\uB8CC-------------------\n\n\uB3CC:
    0km\n\n\uB098\uBB34: 0.05km\n\n\uC720\uB9AC: 0.1km\n\n\uB3D9: 2km\n\n\uC740:
    5km\n\n\uAE08: 20km\n\n\uB8E8\uBE44: 100km\n\n\uC0AC\uD30C\uC774\uC5B4: 300km\n\n\uC5D0\uBA54\uB784\uB4DC:
    500km\n\n\uB9C8\uBC95\uC758 \uB3CC: 1000km\n*\uB9C8\uBC95\uC758 \uB3CC\uC740
    \uB79C\uB364 \uD655\uB960\uB85C \uB4F1\uC7A5\uD569\uB2C8\uB2E4. \n(\uB9E4\uCD08
    1% \uD655\uB960\uB85C \uB098\uC628\uB2E4)"
  m_isRightToLeft: 0
